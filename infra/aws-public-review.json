{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "CheckoutCheck HTTPS judge review; restricted CloudFront origin, no public operator API.",
  "Parameters": {
    "InstanceId": {
      "Type": "AWS::EC2::Instance::Id"
    },
    "SecurityGroupId": {
      "Type": "AWS::EC2::SecurityGroup::Id"
    },
    "CloudFrontPrefixList": {
      "Type": "String"
    },
    "OriginSecret": {
      "Type": "String",
      "NoEcho": true,
      "MinLength": 32
    }
  },
  "Resources": {
    "Address": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc",
        "Tags": [
          {
            "Key": "Project",
            "Value": "CheckoutCheck"
          }
        ]
      }
    },
    "AddressBinding": {
      "Type": "AWS::EC2::EIPAssociation",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "Address",
            "AllocationId"
          ]
        },
        "InstanceId": {
          "Ref": "InstanceId"
        }
      }
    },
    "CloudFrontIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "SecurityGroupId"
        },
        "IpProtocol": "tcp",
        "FromPort": 80,
        "ToPort": 80,
        "SourcePrefixListId": {
          "Ref": "CloudFrontPrefixList"
        },
        "Description": "CloudFront only; nginx additionally verifies origin secret"
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": "CheckoutCheck public read-only judge review",
          "HttpVersion": "http2",
          "IPV6Enabled": true,
          "PriceClass": "PriceClass_100",
          "ViewerCertificate": {
            "CloudFrontDefaultCertificate": true
          },
          "Origins": [
            {
              "Id": "EC2Review",
              "DomainName": {
                "Fn::Join": [
                  "",
                  [
                    "ec2-",
                    {
                      "Fn::Join": [
                        "-",
                        {
                          "Fn::Split": [
                            ".",
                            {
                              "Ref": "Address"
                            }
                          ]
                        }
                      ]
                    },
                    ".compute-1.amazonaws.com"
                  ]
                ]
              },
              "CustomOriginConfig": {
                "HTTPPort": 80,
                "OriginProtocolPolicy": "http-only"
              },
              "OriginCustomHeaders": [
                {
                  "HeaderName": "X-CheckoutCheck-Origin",
                  "HeaderValue": {
                    "Ref": "OriginSecret"
                  }
                }
              ]
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "EC2Review",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD",
              "OPTIONS",
              "PUT",
              "POST",
              "PATCH",
              "DELETE"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "Compress": true,
            "MinTTL": 0,
            "DefaultTTL": 0,
            "MaxTTL": 0,
            "ForwardedValues": {
              "QueryString": false,
              "Cookies": {
                "Forward": "none"
              },
              "Headers": [
                "Content-Type",
                "Range"
              ]
            }
          },
          "CustomErrorResponses": [
            {
              "ErrorCode": 403,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 404,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 500,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 502,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 503,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 504,
              "ErrorCachingMinTTL": 0
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "Endpoint": {
      "Value": {
        "Fn::Join": [
          "",
          [
            "https://",
            {
              "Fn::GetAtt": [
                "Distribution",
                "DomainName"
              ]
            }
          ]
        ]
      }
    },
    "DistributionId": {
      "Value": {
        "Ref": "Distribution"
      }
    },
    "OriginAddress": {
      "Value": {
        "Ref": "Address"
      }
    }
  }
}
